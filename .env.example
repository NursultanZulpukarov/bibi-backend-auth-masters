# Пример строки подключения к базе данных (async driver — asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/bibi_db

# Секрет для подписи JWT-токенов. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Алгоритм и время жизни токена (необязательные, есть значения по умолчанию)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Список разрешённых origin через запятую. Пусто = разрешить все (без credentials)
ALLOWED_ORIGINS=
